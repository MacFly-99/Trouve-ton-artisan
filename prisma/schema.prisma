generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categorie {
  id           Int          @id @default(autoincrement())
  nom          String       @unique
  description  String?
  specialites  Specialite[]
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("categories")
}

model Specialite {
  id           Int          @id @default(autoincrement())
  nom          String       @unique
  description  String?
  categorieId  Int          @map("categorie_id")
  categorie    Categorie    @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  artisans     Artisan[]
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("specialties")
}

model Artisan {
  id             Int          @id @default(autoincrement())
  nom            String
  nomEntreprise  String?      @map("nom_entreprise")
  email          String       @unique
  telephone      String?
  siteWeb        String?      @map("site_web")
  adresse        String?
  ville          String?
  codePostal     String?      @map("code_postal")
  note           Float        @default(0) // Ton Excel a des notes décimales
  description    String?
  urlImage       String?      @map("url_image")
  specialiteId   Int          @map("specialite_id")
  specialite     Specialite   @relation(fields: [specialiteId], references: [id], onDelete: Cascade)
  estVedette     Boolean      @default(false) @map("est_vedette")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("artisans")
}